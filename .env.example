# Salin berkas ini menjadi `.env` lalu isi nilainya. `.env` TIDAK PERNAH di-commit.

# --- Gemini ---
# Dipakai untuk embedding retrieval, dan untuk narasi bila LLM_PROVIDER=gemini.
GEMINI_API_KEY=

# --- Pemilih backend LLM ---
# "gemini" (bawaan) atau "ollama".
#
# Bawaannya sengaja Gemini: setiap angka yang sudah dilaporkan dihasilkan
# dengannya, dan bawaan yang diam-diam berganti backend akan membuat hasil lama
# tidak bisa direproduksi tanpa ada yang menyadarinya.
#
# Untuk satu kali jalan tanpa mengubah berkas:
#   LLM_PROVIDER=ollama python scripts/run_assessment.py ...
LLM_PROVIDER=gemini

# --- Model swa-inang (Ollama lewat OpenWebUI, mis. di Vast.ai) ---
# Alamat OpenWebUI, TANPA garis miring di akhir. Instance Vast.ai mendapat
# alamat baru setiap kali dinyalakan, jadi nilai ini berubah-ubah — itulah
# sebabnya ia ada di sini dan tidak pernah di dalam kode.
OPENWEBUI_BASE_URL=

# OpenWebUI > Settings > Account > API keys.
# Kode menghubungi Ollama LEWAT OpenWebUI, bukan langsung ke port 11434, supaya
# ada autentikasi di depannya: instance Vast.ai beralamat publik, dan Ollama
# polos tanpa autentikasi berarti GPU sewaanmu terbuka bagi siapa pun yang
# memindai rentang IP itu.
OPENWEBUI_API_KEY=

# Tag model persis seperti yang dilaporkan `ollama list`, mis. qwen3:32b.
# Tidak ada nilai bawaan dengan sengaja — tag yang salah harus gagal saat
# start, bukan membuat server menjawab dengan model lain sementara hasilnya
# mencatat nama model yang tidak pernah dijalankan.
OLLAMA_MODEL=

# --- Lain-lain ---
KAGGLE_API_TOKEN=
