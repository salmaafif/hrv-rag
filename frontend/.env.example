# Copy to `.env.local` and adjust. Vite only exposes variables prefixed VITE_.
#
# Never put GEMINI_API_KEY here or anywhere else under frontend/. Anything the
# browser receives can be read from DevTools, so the model key stays on the
# server — see `docs/frontend_plan.md` section 4.

# Use the built-in dummy backend instead of a real one.
# Anything other than the exact string "false" keeps the dummy on, so a typo
# leaves you with obviously fake data rather than a demo silently pointing at a
# server that is not running.
VITE_USE_MOCK_API=true

# Where FastAPI lives. Only read when VITE_USE_MOCK_API=false.
VITE_API_BASE_URL=http://localhost:8000

# Key the backend accepts, sent as `X-API-Key`. Must appear in the server's
# HRV_API_KEYS list. Only read when VITE_USE_MOCK_API=false.
#
# NOT a secret: anything the browser holds is readable from DevTools. It is a
# gate against passing scanners, not against a person. In the deployed shape
# KARIRLINK's gateway calls the API server-to-server and the browser holds no
# key at all — this exists so the demo can run without a gateway.
VITE_API_KEY=
